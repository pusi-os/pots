# Maintainer: Pusi <pusi-os@users.noreply.github.com>
# https://github.com/pusi-os/pots

pkgname=pots-bin
pkgver=3.3.0
pkgrel=1
pkgdesc='Pots — AI assistant by Pusi with persistent memory and local models'
arch=('x86_64')
url='https://github.com/pusi-os/pots'
license=('Apache-2.0')
depends=('hicolor-icon-theme')
provides=('pots')
conflicts=('pots')
options=('!strip')

source=("Pots-${pkgver}-linux-x86_64.tar.gz::https://github.com/pusi-os/pots/releases/download/v${pkgver}/Pots-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('aaf111532900f674a75c963721d027179d07faace520e6a02a23c33ead2d7330')

package() {
    # Install application files
    install -dm755 "${pkgdir}/opt/pots"
    cp -r "${srcdir}/Pots/"* "${pkgdir}/opt/pots/"
    chmod -R go-w "${pkgdir}/opt/pots"

    # Install wrapper script
    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/pots" << 'EOF'
#!/bin/sh
exec /opt/pots/bin/Pots "$@"
EOF

    # Install desktop entry
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/pots.desktop" << EOF
[Desktop Entry]
Name=Pots
Comment=AI assistant powered by Ollama, Gemini, ChatGPT and more
Exec=pots
Icon=pots
Type=Application
Categories=Utility;Network;
Keywords=AI;Chat;Ollama;Gemini;LLM;Assistant;
StartupWMClass=compose-window
Terminal=false
EOF

    # Install icon
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/icons/hicolor/scalable/apps/pots.svg" << 'EOF'
<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
