<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

   <uses-permission android:name="android.permission.INTERNET"/>
   <!-- Android 17+ blocks LAN traffic for apps targeting SDK 37+ without this runtime
        permission; required to reach self-hosted servers (Jan, Ollama, LM Studio, ...). -->
   <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
   <uses-permission android:name="android.permission.READ_CALENDAR"/>
   <!-- The contact tools: search reads, create writes. Dialing goes through
        ACTION_DIAL, which needs no permission, so CALL_PHONE is deliberately absent. -->
   <uses-permission android:name="android.permission.READ_CONTACTS"/>
   <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
   <!-- Photo search reads the user's image library. Downloads are written through MediaStore,
        which needs no storage permission on Android 10+. -->
   <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
   <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
   <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
   <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
   <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
   <!-- Asks to be left out of battery optimisation (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS).
        Without this permission the request is ignored by the system. Needed because a
        background sandbox dies with the app process once Doze freezes it. -->
   <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
   <!-- Microphone, for the hands-free voice mode. -->
   <uses-permission android:name="android.permission.RECORD_AUDIO"/>
   <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
   <!-- Desktop pet: the character standing on the desktop in a system overlay
        window while the app is in the background (opt-in, off by default). -->
   <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
   <!-- The cloud's voice loop records from the pet's foreground service, which
        is a background service by definition. Android 14+ hands the microphone
        to a foreground service only when its type says microphone — without
        this, startListening() is accepted and nothing is ever recorded. -->
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
   <!-- The screen mode: a MediaProjection session has to live under a
       foreground service of this type (Android 14+). -->
   <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
   <!-- Reading the screen as text when Pots is the device assistant: the
        platform hands an AssistStructure to the voice-interaction session at
        every invocation. normal, so it is granted at install; the user's own
        consent is the "Use text from screen" switch on the assistant screen. -->
   <uses-permission android:name="android.permission.READ_ASSIST_STRUCTURE_SCREEN_CONTENT"/>

   <!-- Bluetooth for companion pairing. CONNECT/ADVERTISE/SCAN are runtime permission on Android 12+. -->
   <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
   <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
   <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
   <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
   <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
       android:usesPermissionFlags="neverForLocation"/>
   <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>

    <!-- Package visibility for the camera entry in the attachment chooser. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name="com.pusios.pots.PotsApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:name="com.pusios.pots.MainActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <service
            android:name="com.pusios.pots.PotsAssistTileService"
            android:exported="true"
            android:icon="@drawable/ic_launcher_foreground"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
        <!-- The cloud's text field: a floating translucent screen, so the
             keyboard lifts the field instead of covering it. -->
        <activity
            android:name="com.pusios.pots.overlay.PotsikTextInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/PotsikTextInputTheme"
            android:windowSoftInputMode="adjustResize" />
        <!-- The consent dialog of the screen mode: an activity, because only an
             activity can receive the result of the MediaProjection intent.
             It gets a task of its own (taskAffinity + singleInstance): launched
             into the app's task, it would bring the app to the front, and the
             frame taken right after the answer would show the last Pots screen
             instead of the screen the user was on. -->
        <activity
            android:name="com.pusios.pots.overlay.PotsikScreenCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.pusios.pots.screenconsent"
            android:theme="@style/PotsikTextInputTheme" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- The mini-app server and the daemon are keep-alives for long-lived
             local work, not syncs: dataSync is capped at six hours per day on
             Android 15+ (onTimeout), which would stop them mid-day. specialUse
             has no time budget. The attribute is only read from API 34, where
             the type was added; older versions ignore it, and the services call
             startForeground without a type below that (see the SDK_INT fork in
             each service) — no second manifest entry is needed for old OSes. -->
        <service
            android:name="com.pusios.pots.MiniAppServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the local mini-app server reachable while the app is in the background" />
        </service>
        <service
            android:name="com.pusios.pots.DaemonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the app process alive so scheduled tasks, heartbeat and email polling run in the background" />
        </service>
        <!-- The sandbox's own keep-alive: its own service so that stopping the
             sandbox does not stop the task daemon, and the other way round. -->
        <service
            android:name="com.pusios.pots.SandboxBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's local Linux sandbox running while the app is in the background" />
        </service>
        <!-- Model downloads really are a sync, and the six-hour budget is the
             right ceiling for one. -->
        <service
            android:name="com.pusios.pots.inference.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- The desktop pet window. specialUse and not dataSync: dataSync is
             capped at six hours a day on Android 15+, and a pet standing on
             the desktop is not a sync. `microphone` rides along because the
             cloud's voice loop records from this service: on Android 14+ the
             type is what grants a background service the microphone, and it
             is added to specialUse rather than replacing it — the window is
             still the special use, the listening is the microphone. -->
        <service
            android:name="com.pusios.pots.overlay.PotsOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's desktop pet character visible in a system overlay window while the app is in the background" />
        </service>
        <!-- The screen mode's session. Its own service and not the pet's: the
             type has to be mediaProjection, and leaving the mode has to end
             exactly this service. -->
        <service
            android:name="com.pusios.pots.overlay.PotsikScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Pots as the device assistant. Declaring this service is the whole
             qualification for the role: it is what puts Pots in the system's
             assistant list and what makes the assist gesture (long-press Home,
             swipe up from a bottom corner) route here instead of to the
             ACTION_ASSIST activity above. The metadata's usesAssist* attributes
             are not optional on targetSdk 37: without them the platform strips
             assist data from every session. -->
        <service
            android:name="com.pusios.pots.assistant.PotsVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <!-- One session per invocation: it takes the screen's text and hands it
             to Потсик. Bound by the system with BIND_ALLOW_BACKGROUND_ACTIVITY_STARTS,
             which is what lets the gesture bring the pet up from a background
             process. -->
        <service
            android:name="com.pusios.pots.assistant.PotsVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- The metadata has to name a recognition service even though Android
             12+ ignores it: without one the system resets the assistant on this
             app. Listening itself is the hands-free loop's own recognizer, so
             this service only answers with an error. -->
        <service
            android:name="com.pusios.pots.assistant.PotsAssistRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>
        <uses-native-library android:name="libvndksupport.so" android:required="false"/>
        <uses-native-library android:name="libOpenCL.so" android:required="false"/>
    </application>

</manifest>