<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="pots_secure_prefs.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    <!-- The encrypted password vault: user credentials must never leave the
         device through Auto Backup, even though the file is ciphertext. -->
    <exclude domain="file" path="vault/" />
    <!-- The ADB host key and the device registry: a key restored onto another
         device would impersonate this one to every paired Android device. -->
    <exclude domain="file" path="adb/" />
</full-backup-content>
